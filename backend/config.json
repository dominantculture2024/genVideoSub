{
  "mode": "production",
  "environment": "production",
  "api_provider": "fal_ai",
  "server": {
    "host": "localhost",
    "port": 8080,
    "timeout": 30
  },
  "fal_ai": {
    "api_key": "",
    "base_url": "https://fal.run",
    "timeout": 300
  },
  "storage": {
    "data_path": "./data",
    "temp_path": "./temp",
    "max_file_size": 104857600
  },
  "worker_pool": {
    "max_concurrent": 3,
    "queue_size": 100
  },
  "api_provider_configs": {
    "fal_ai": {
      "api_key": "",
      "base_url": "https://fal.run",
      "timeout": 300,
      "headers": {},
      "enabled": true
    },
    "runway_ml": {
      "api_key": "",
      "base_url": "https://api.runwayml.com",
      "timeout": 300,
      "headers": {},
      "enabled": false
    },
    "stability_ai": {
      "api_key": "",
      "base_url": "https://api.stability.ai",
      "timeout": 300,
      "headers": {},
      "enabled": false
    }
  },
  "curl": {
    "curl_timeout": 60,
    "curl_retries": 3,
    "curl_enabled": true
  }
}